  },
  "redirects": [
    {
      "source": "/integrations/mcp",
      "destination": "/integrations/mcp/vaquill"
    },
    {
      "source": "/integrations/courtlistener-mcp",
      "destination": "/integrations/mcp/courtlistener"
    },
    {
      "source": "/integrations/canlii-mcp",
      "destination": "/integrations/mcp/canlii"
    }
  ],
  "appearance": {
    "default": "light",
    "strict": true
  }
}
