{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vaquill AI",
  "description": "US primary law as a developer API. The US Code, the CFR, the Federal Register, state and territory statute codes, state regulations, constitutions and court rules, with Bluebook citation resolution and point-in-time retrieval over REST, MCP and SQL.",
  "colors": {
    "primary": "#6E3730",
    "light": "#8C4A3F",
    "dark": "#5A2D27"
  },
  "background": {
    "color": {
      "light": "#FAFAF9"
    }
  },
  "thumbnails": {
    "appearance": "light",
    "fonts": {
      "family": "Source Serif 4"
    }
  },
  "fonts": {
    "heading": {
      "family": "Source Serif 4",
      "weight": 400
    },
    "body": {
      "family": "Schibsted Grotesk",
      "weight": 400
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://vaquill.ai"
  },
  "favicon": "/favicon.png",
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search docs, guides, and the API reference..."
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "That page doesn't exist, or the URL changed. Try the search bar above, or start from the [API overview](/api-guide/overview)."
    }
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://www.vaquill.ai/docs",
      "og:site_name": "Vaquill AI Docs",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:site": "@vaquillai"
    }
  },
